# Database Configuration
# Options: sqlite, postgresql, mysql
DB_TYPE=sqlite

# SQLite Configuration (only used when DB_TYPE=sqlite)
SQLITE_DATABASE_NAME=liblogs.db

# PostgreSQL Configuration (only used when DB_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=liblogs

# MySQL Configuration (only used when DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=liblogs

# Connection Pool Settings (PostgreSQL/MySQL only)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=30000
